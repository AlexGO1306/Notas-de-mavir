rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Blueprint for Level
    function isValidLevel(data) {
      return data.keys().hasAll(['name', 'createdAt']) 
        && data.keys().size() == 2
        && data.name is string 
        && data.name.size() > 0 
        && data.name.size() <= 100
        && data.createdAt == request.time;
    }

    // Validation Blueprint for Student
    function isValidStudent(data) {
      return data.keys().hasAll(['name', 'levelId', 'progress', 'createdAt', 'updatedAt'])
        && data.keys().size() == 5
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.levelId is string
        && data.levelId.size() > 0
        && data.levelId.size() <= 128
        && data.progress is map
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidStudentUpdate(data) {
      return data.keys().hasAll(['name', 'levelId', 'progress', 'createdAt', 'updatedAt'])
        && data.keys().size() == 5
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.levelId is string
        && data.levelId.size() > 0
        && data.levelId.size() <= 128
        && data.progress is map
        && data.createdAt == existing().createdAt
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      // Basic profile or placeholder if needed. Since we just use it as a parent, no explicit fields strictly needed, but let's lock it.
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if false; // Not needed currently
      allow delete: if false;

      match /levels/{levelId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) 
          && isValidId(levelId) 
          && isValidLevel(incoming());
        allow update: if false; // Levels are currently just name, no update needed yet. If needed, can be added.
        allow delete: if isOwner(userId) && isValidId(levelId);
      }

      match /students/{studentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) 
          && isValidId(studentId) 
          && isValidStudent(incoming());
        allow update: if isOwner(userId) 
          && isValidId(studentId)
          && isValidStudentUpdate(incoming())
          && incoming().diff(existing()).affectedKeys().hasAny(['name', 'levelId', 'progress', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(studentId);
      }
    }
  }
}
